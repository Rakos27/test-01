{
  "name": "dealyva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev -H 0.0.0.0 --port 4173",
    "build": "node scripts/prepare-adsense.mjs && node scripts/generate-seo.mjs && tsc -b && vinext build && node scripts/prepare-sites-build.mjs",
    "build:pages": "node scripts/prepare-adsense.mjs && ROUTER_MODE=hash node scripts/generate-seo.mjs && tsc -b && vite build --config vite.static.config.ts",
    "lint": "eslint .",
    "qa": "node scripts/qa.mjs",
    "audit:user": "node scripts/user-journey-audit.mjs",
    "awin:check": "node --env-file-if-exists=.env.local scripts/awin-check.mjs",
    "awin:audit": "node --env-file-if-exists=.env.local scripts/awin-opportunity-audit.mjs",
    "awin:sync": "node --env-file-if-exists=.env.local scripts/awin-sync.mjs",
    "awin:review": "node --env-file-if-exists=.env.local scripts/awin-review-server.mjs",
    "awin:publish": "node --env-file-if-exists=.env.local scripts/awin-publish.mjs",
    "test:awin": "node scripts/awin-moderation.test.mjs",
    "preview": "wrangler dev --config dist/server/wrangler.json --ip 0.0.0.0",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "react-router-dom": "7.18.2",
    "vinext": "^1.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitejs/plugin-rsc": "^0.5.26",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.0",
    "wrangler": "^4.65.0"
  }
}
